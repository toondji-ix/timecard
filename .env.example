# Supabase PostgreSQL Transaction pooler URI (server-only; Render Environment).
# Copy from Supabase Connect, replace the database password, and URL-encode special characters.
DATABASE_URL=
# Local development only when DATABASE_URL is empty:
DATABASE_PATH=data/timecard.sqlite
# Optional backup output; copy backups off Render after creation.
BACKUP_DIRECTORY=data/backups
APP_URL=http://localhost:3000
# Generate at least 32 random characters before production.
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
EMAIL_API_KEY=
EMAIL_FROM=Timecard <hello@example.com>
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_LIVENESS_ROLE_ARN=
LIVENESS_THRESHOLD=95
FREE_STAFF_LIMIT=15
BUSINESS_STAFF_LIMIT=3000
NEXT_PUBLIC_FREE_STAFF_LIMIT=15
NEXT_PUBLIC_BUSINESS_STAFF_LIMIT=3000
SALES_EMAIL=
# Enterprise OpenID Connect, pre-invited workspace members only.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_WORKSPACE_ID=
# Set off only when an external scheduler runs npm run maintenance.
TIMECARD_MAINTENANCE=on
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
BUSINESS_MONTHLY_AMOUNT=1500000
BUSINESS_CURRENCY=NGN
NEXT_PUBLIC_BUSINESS_PRICE_LABEL=₦15,000

# Supabase Auth (email/password + Google configured in Supabase Dashboard)
# Preferred server-runtime names on Render; existing NEXT_PUBLIC names also work.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key: required for Supabase workspace invitations and account deletion. Never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
